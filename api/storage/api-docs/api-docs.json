        "/api/v1/exchange-requests": {
            "get": {
                "tags": [
                    "Exchange Requests"
                ],
                "summary": "Lister et filtrer les demandes",
                "operationId": "f8b060d813da0fbd01ca7bbb4f95610b",
                "parameters": [
