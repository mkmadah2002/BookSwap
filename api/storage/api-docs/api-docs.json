    "components": {
        "schemas": {
            "User": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Yassine Amrani"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "avatar": {
                        "type": "string"
                    },
                    "group_name": {
                        "type": "string",
                        "example": "CyphX A"
                    }
                },
                "type": "object"
            },
            "Book": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string",
                        "example": "Clean Code"
                    },
                    "author": {
                        "type": "string",
                        "example": "Robert C. Martin"
                    },
                    "description": {
                        "type": "string"
                    },
                    "image_url": {
                        "type": "string",
                        "example": "/images/books/book-1.svg"
                    },
                    "category": {
                        "type": "object"
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "type": "object"
            },
            "ExchangeRequestInput": {
                "required": [
                    "user_id",
                    "book_id",
                    "exchange_type",
                    "status"
                ],
                "properties": {
                    "user_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "book_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "exchange_type": {
                        "type": "string",
                        "enum": [
                            "permanent",
                            "temporary"
                        ]
                    },
                    "start_date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "end_date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "open",
                            "closed",
                            "cancelled"
                        ]
                    }
                },
                "type": "object"
            },
            "ExchangeOfferInput": {
                "required": [
                    "user_id",
                    "offered_book_id",
                    "exchange_type",
                    "status"
                ],
                "properties": {
                    "user_id": {
                        "type": "integer",
                        "example": 2
                    },
                    "offered_book_id": {
                        "type": "integer",
                        "example": 2
                    },
                    "exchange_type": {
                        "type": "string",
                        "enum": [
                            "permanent",
                            "temporary"
                        ]
                    },
                    "start_date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "end_date": {
                        "type": "string",
                        "format": "date",
                        "nullable": true
                    },
                    "message": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "pending",
                            "accepted",
                            "rejected"
                        ]
                    }
                },
                "type": "object"
            }
        }
    },
